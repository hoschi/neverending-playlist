# Supabase
SUPABASE_URL="your-supabase-url"
SUPABASE_KEY="your-supabase-key"
# Name der Supabase-Tabelle für Spotify-Sync
SUPABASE_TABLE=_spotify_to_supabase_test

# Song source backend (SUPABASE | SQLITE)
SONG_SOURCE="SQLITE"

# SQLite backend (file in repository root)
SQLITE_DB_PATH="neverending_songs.db"
# Set in GB (e.g. 10 => 10 GB, internally converted to bytes)
SQLITE_MAX_SIZE_GB=10

# NeverendingSongs sources (JSON list of fully configured REST URLs, multiple sources supported)
# Optional: `start`/`end` can be plain HH:MM (e.g. 07:00/22:00) and are resolved to yesterday's date.
SONG_SOURCE_REST_URLS='["https://iris-bob.loverad.io/search.json?station=110&start=07:00&end=22:00", "https://example.com/source.json?station=42&start=07:00&end=22:00"]'

# Debug override: trigger one immediate import at app startup
# (daily scheduler checks continue to run hourly afterwards)
DEBUG_SYNC_AT_STARTUP=false

# Optional macOS notifications for scheduler/import failures and unhandled server errors
ENABLE_MAC_NOTIFICATIONS=false

# Spotify
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_REDIRECT_URI="https://localhost:6361/callback"
SPOTIFY_PLAYLIST_ID="your-spotify-playlist-id"

# Playlist Autofill (optional)
# The system will automatically refill until this minimum is reached
# If not set or empty, playlist will only be cleared without refill
PLAYLIST_AUTOFILL_COUNT=150

# Watch Service Timeout (optional)
# Timeout in minutes for the watch service interval
# Default: 10 minutes
WATCH_SERVICE_TIMEOUT_MINUTES=10

# Encryption
ENCRYPTION_KEY="your-32-byte-encryption-key"

# SSL
SSL_CERT_PATH="ssl/cert.pem"
SSL_KEY_PATH="ssl/key.pem"